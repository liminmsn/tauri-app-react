{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app-react",
  "version": "0.1.0",
  "identifier": "com.limin.tauri-app-react",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-app-react",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
 "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ]
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}