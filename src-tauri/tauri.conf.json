{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "巨量动漫",
  "version": "1.1.0",
  "identifier": "com.limin.tauri-app-react",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "devtools": true,
        "title": "巨量动漫",
        "width": 900,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": true,
        "create": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe inline'; style-src 'self' 'unsafe-inline'; script-src 'self' https://hm.baidu.com 'unsafe-inline'; connect-src 'self' https://hm.baidu.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": {
        "installerIcon": "./icons/icon.png",
        "languages": [
          "SimpChinese"
        ]
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}