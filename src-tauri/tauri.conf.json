{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app-react",
  "version": "0.1.0",
  "identifier": "com.limin.tauri-app-react",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "巨量动漫",
        "width": 900,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": true,
        "create": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://hm.baidu.com 'unsafe-inline'; connect-src 'self' https://hm.baidu.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}